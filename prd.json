{
  "title": "Ralph Tracer Bullet",
  "version": "0.3.0",
  "status": "validated",
  "overview": {
    "description": "A Ralph-loop based project to be used with the Ralph-TUI terminal user interface.",
    "purpose": "This project won't produce anything real, but will be used as a tracer bullet to ensure that Ralph-TUI and its dependencies are working well."
  },
  "goals": [
    "Validate Ralph-TUI core loop functionality with local task trackers (prd.json, beads)",
    "Establish baseline for future integrations"
  ],
  "future_scope": [
    "GitHub Issues integration for reading tasks/PRDs",
    "Other remote task tracker integrations",
    "Custom domain configuration",
    "Ralph-TUI full loop execution"
  ],
  "validated": {
    "date": "2026-01-15",
    "capabilities": [
      {
        "capability": "gh CLI authentication",
        "status": "validated",
        "notes": "OAuth device flow, workflow scope added"
      },
      {
        "capability": "git push to GitHub",
        "status": "validated",
        "notes": "Required gh auth setup-git for credential helper"
      },
      {
        "capability": "Next.js app scaffolding",
        "status": "validated",
        "notes": "create-next-app with TypeScript, Tailwind, App Router"
      },
      {
        "capability": "Vercel CLI deployment",
        "status": "validated",
        "notes": "vercel login + vercel deploy"
      },
      {
        "capability": "GitHub Actions CI/CD",
        "status": "validated",
        "notes": "Auto-deploy on push to main, preview on PR"
      },
      {
        "capability": "PR preview deployments",
        "status": "validated",
        "notes": "Preview URL auto-commented on PR"
      },
      {
        "capability": "Production deployment on merge",
        "status": "validated",
        "notes": "Merge to main triggers production deploy"
      },
      {
        "capability": "GitHub secrets management",
        "status": "validated",
        "notes": "gh secret set for VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID"
      },
      {
        "capability": "Beads task tracker",
        "status": "validated",
        "notes": "bd init, bd create, bd ready, bd sync, git hooks installed"
      }
    ],
    "urls": {
      "production": "https://app-peach-theta.vercel.app",
      "github": "https://github.com/mdcarlson/ralph-tracer-bullet",
      "vercel_dashboard": "https://vercel.com/mark-carlsons-projects-774551d5/app"
    }
  },
  "deployment": {
    "strategy": "GitHub Actions + Vercel CLI",
    "workflow": ".github/workflows/deploy.yml",
    "environments": {
      "production": {
        "trigger": "push to main",
        "url": "https://app-peach-theta.vercel.app"
      },
      "preview": {
        "trigger": "push to non-main branch or PR",
        "url": "auto-generated per deployment"
      }
    },
    "secrets_required": [
      "VERCEL_TOKEN",
      "VERCEL_ORG_ID",
      "VERCEL_PROJECT_ID"
    ],
    "configuration_files": {
      ".github/workflows/deploy.yml": {
        "purpose": "CI/CD pipeline for Vercel deployment",
        "gitignore": false
      },
      ".vercel/project.json": {
        "purpose": "Local project linking (org/project IDs)",
        "gitignore": true
      },
      ".env.local": {
        "purpose": "Local dev secrets",
        "gitignore": true
      }
    }
  },
